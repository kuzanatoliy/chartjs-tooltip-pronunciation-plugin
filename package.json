    "test": "jest src --coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@kuzanatoliorg/commitlint-config": "^1.4.0",
